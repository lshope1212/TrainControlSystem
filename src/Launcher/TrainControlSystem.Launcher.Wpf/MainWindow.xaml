<Window x:Class="TrainControlSystem.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Train Control System" Height="520" Width="620">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
        <TextBlock Margin="0,4,0,20" TextWrapping="Wrap" Foreground="Gray"
                   Text="Central launcher. Each module below is a separate executable and is started as its own process." />

        <!-- Modules -->
        <TextBlock Text="Modules" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Launch" Width="100" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding DataContext.LaunchModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Launch All" Width="120" Padding="8,4" Margin="0,12,0,0"
                HorizontalAlignment="Center" Command="{Binding LaunchAllCommand}" />

        <Separator Margin="0,20,0,16" />

        <!-- Simulation (placeholders) -->
        <TextBlock Text="Simulation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="System Time:" Margin="0,0,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemTime}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Simulation Speed:" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                       Text="{Binding SimulationSpeed, StringFormat={}{0:0.0}x}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Pause" Width="100" Padding="8,4" Margin="0,0,12,0" Command="{Binding PauseCommand}" />
            <Button Content="Resume" Width="100" Padding="8,4" Command="{Binding ResumeCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="Gray" />
    </StackPanel>
</Window>
