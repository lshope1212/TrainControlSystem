<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Ink" Color="#111111"/>
 <SolidColorBrush x:Key="Muted" Color="#111111"/>
 <SolidColorBrush x:Key="Line" Color="#D1DEEB"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F2F7FB"/></Style>
 <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="8"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
 <Style x:Key="Value" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,0,0,3"/></Style>
 <Style TargetType="TextBox"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Background" Value="#FAFCFF"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E4ECF4"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="Background" Value="White"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Background" Value="#F1F6FB"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="9,4"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/></Style>

 <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="#EAF2FB"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="30"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DAE9FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C8DEF6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox"><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#FAFCFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"><TextBlock Text="⌄" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,5,30,5" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
      <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,5"/></Style>
 <Style x:Key="OutputValue" TargetType="TextBlock">
  <Setter Property="Foreground" Value="#175BA6"/><Setter Property="FontWeight" Value="Bold"/>
  <Style.Triggers>
   <Trigger Property="Text" Value="FAILURE"><Setter Property="Foreground" Value="#A62C21"/></Trigger>
   <Trigger Property="Text" Value="OCCUPIED"><Setter Property="Foreground" Value="#A62C21"/></Trigger>
   <Trigger Property="Text" Value="STOP"><Setter Property="Foreground" Value="#A62C21"/></Trigger>
   <Trigger Property="Text" Value="RED"><Setter Property="Foreground" Value="#A62C21"/></Trigger>
   <Trigger Property="Text" Value="NORMAL"><Setter Property="Foreground" Value="#116A36"/></Trigger>
   <Trigger Property="Text" Value="CLEAR"><Setter Property="Foreground" Value="#116A36"/></Trigger>
   <Trigger Property="Text" Value="PROCEED"><Setter Property="Foreground" Value="#116A36"/></Trigger>
   <Trigger Property="Text" Value="GREEN"><Setter Property="Foreground" Value="#116A36"/></Trigger>
   <Trigger Property="Text" Value="UNKNOWN"><Setter Property="Foreground" Value="#855300"/></Trigger>
   <Trigger Property="Text" Value="CAUTION"><Setter Property="Foreground" Value="#855300"/></Trigger>
   <Trigger Property="Text" Value="YELLOW"><Setter Property="Foreground" Value="#855300"/></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
