<Window x:Class="TrackModel.TestUI.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Track Model — Test UI" Style="{StaticResource {x:Type Window}}"
 Width="1360" Height="760" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#102236" Padding="18,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="TRACK MODEL TEST UI" FontSize="26" FontWeight="Bold" Foreground="White"/>

    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="Captured messages" Click="ShowMessages" Margin="0,0,8,0" AutomationProperties.Name="Captured messages"/>
     <Button Content="Refresh outputs" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh outputs"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
   <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
  </Border>
  <Grid Margin="12,8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>

   <Grid Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding SelectedOutput.LastReceived, StringFormat=Last received: {0}}" Foreground="{StaticResource Muted}" FontSize="14"/>
    <TextBlock Grid.Column="1" Text="Output block" HorizontalAlignment="Right" Margin="0,0,8,0"/>
    <ComboBox Grid.Column="2" ItemsSource="{Binding OutputBlocks}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Id" AutomationProperties.Name="Output block"/>
   </Grid>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel>
    <TextBlock Text="From Track Controller" Style="{StaticResource Heading}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Block" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{Binding Blocks}" DisplayMemberPath="BlockId" SelectedItem="{Binding SelectedCommandBlock}" AutomationProperties.Name="Command block" />
<TextBlock Grid.Row="1" Text="Speed (mph)" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Commanded speed mph" />
<TextBlock Grid.Row="2" Text="Authority (ft)" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,2" Text="{Binding Authority, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Authority feet" />
<TextBlock Grid.Row="3" Text="Switch" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{Binding SwitchOptions}" SelectedItem="{Binding Switch}" IsEnabled="{Binding HasSwitch}" AutomationProperties.Name="Switch command" />
<TextBlock Grid.Row="4" Text="Signal" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
<Grid Grid.Row="4" Grid.Column="1" Margin="0,2,0,2">
 <ComboBox ItemsSource="{Binding SignalOptions}" SelectedItem="{Binding Signal}" IsEnabled="{Binding HasSignal}" AutomationProperties.Name="Signal command">
  <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasSignal}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
 </ComboBox>
 <Border Background="#FAFCFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10,3">
  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSignal}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
  <TextBlock Text="No signal" FontWeight="SemiBold"/>
 </Border>
</Grid>
<TextBlock Grid.Row="5" Text="Crossing" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{Binding CrossingOptions}" SelectedItem="{Binding Crossing}" IsEnabled="{Binding HasCrossing}" AutomationProperties.Name="Crossing command" />
</Grid>

   </StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel>
    <TextBlock Text="From Train Model" Style="{StaticResource Heading}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Train ID" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" Text="{Binding TrainId, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Train ID" />
<TextBlock Grid.Row="1" Text="Current block" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{Binding Blocks}" DisplayMemberPath="BlockId" SelectedItem="{Binding SelectedTrainBlock}" AutomationProperties.Name="Train current block" />
<TextBlock Grid.Row="2" Text="Occupancy" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{Binding TrainOccupancyOptions}" SelectedItem="{Binding TrainOccupancy}" AutomationProperties.Name="Train occupancy" />
<TextBlock Grid.Row="3" Text="Actual speed (mph)" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" Text="{Binding ActualSpeed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual speed mph" />
<Grid Grid.Row="4" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <TextBlock Text="Boarding" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/><TextBox Grid.Column="1" Margin="0,2,8,2" Text="{Binding Boarding, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Boarding passengers" />
 <TextBlock Grid.Column="2" Text="Disembarking" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/><TextBox Grid.Column="3" Margin="0,2,0,2" Text="{Binding Disembarking, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Disembarking passengers" />
</Grid>
</Grid>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
     <Button Content="Apply passenger exchange once" Command="{Binding SendTrainCommand}" AutomationProperties.Name="Apply passenger exchange once" Margin="0,0,6,0"/>
     <Button Content="Remove train" Command="{Binding RemoveTrainCommand}" AutomationProperties.Name="Remove train"/>
    </StackPanel>

   </StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel>
    <TextBlock Text="To Track Controller" Style="{StaticResource Heading}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Occupancy" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOutput.Occupancy}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="1" Text="Broken rail" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOutput.BrokenRail}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="2" Text="Track circuit" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOutput.TrackCircuit}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="3" Text="Power" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOutput.Power}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="4" Text="Switch position" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedOutput.Switch}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="5" Text="Crossing gates" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedOutput.Crossing}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
</Grid>

   </StackPanel></Border>
   <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Failure Injection" Style="{StaticResource Heading}"/>
    <TextBlock Text="{Binding BlockId, StringFormat=Block {0}}" Foreground="{StaticResource Muted}"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
     <CheckBox Content="Broken rail" IsChecked="{Binding BrokenRail}" Margin="0,6,12,6" AutomationProperties.Name="Inject broken rail"/>
     <CheckBox Content="Track circuit" IsChecked="{Binding Circuit}" Margin="0,6,12,6" AutomationProperties.Name="Inject track circuit"/>
     <CheckBox Content="Power" IsChecked="{Binding Power}" AutomationProperties.Name="Inject power"/>
    </StackPanel>
    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Temperature (°F)"/>
     <TextBox Grid.Column="1" Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ambient temperature Fahrenheit"/>
    </Grid>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,5,0,0"><StackPanel>
     <TextBlock Text="Shared System Clock" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Time (HH:mm:ss)" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="System time" />
<TextBlock Grid.Row="1" Text="Speed multiplier" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Text="{Binding Multiplier, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Clock multiplier" />
</Grid>
     <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
      <Button Content="{Binding ClockAction}" Command="{Binding ToggleClockCommand}" Margin="0,0,8,0" AutomationProperties.Name="Toggle simulation clock"/>
      <Button Content="Step 10 sec" Command="{Binding StepClockCommand}" AutomationProperties.Name="Step 10 sec"/>
     </StackPanel>
    </StackPanel></Border>
   </StackPanel></Border>
   <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="To Train Model" Style="{StaticResource Heading}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Train" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOutput.Train}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="1" Text="Commanded speed" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOutput.Speed}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="2" Text="Actual speed" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOutput.ActualSpeed}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="3" Text="Authority" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOutput.Authority}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="4" Text="Track signal" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedOutput.TrackSignal}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="5" Text="Beacon" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedOutput.Beacon}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="6" Text="Elevation / grade" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedOutput.ElevationGrade}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="7" Text="Passenger demand" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedOutput.Demand}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
<TextBlock Grid.Row="8" Text="Next block" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedOutput.NextBlock}" Style="{StaticResource OutputValue}" Margin="8,0,0,0"/>
</Grid>
   </StackPanel></Border>
   <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="To Train Controller &amp; CTC" Style="{StaticResource Heading}"/>
    <TextBlock Text="Traffic light" Foreground="{StaticResource Muted}" Margin="0,4,0,3"/>
    <TextBlock Text="{Binding SelectedOutput.TrafficLight}" Style="{StaticResource OutputValue}" FontSize="19"/>
    <TextBlock Text="Tickets in preceding simulation hour" Foreground="{StaticResource Muted}" Margin="0,10,0,3"/>
    <TextBlock Text="{Binding TicketSales}" Style="{StaticResource OutputValue}" FontSize="17"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
     <TextBlock Text="Boarded / disembarked"/><TextBlock Grid.Column="1" Text="{Binding SelectedOutput.PassengerTotals}" Style="{StaticResource OutputValue}"/>
     <TextBlock Grid.Row="1" Text="Cumulative station tickets"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOutput.Tickets}" Style="{StaticResource OutputValue}"/>
     <TextBlock Grid.Row="2" Text="Temperature"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOutput.Temperature}" Style="{StaticResource OutputValue}"/>
     <TextBlock Grid.Row="3" Text="Track heater"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOutput.Heater}" Style="{StaticResource OutputValue}"/>
    </Grid>
   </StackPanel></Border>
  </Grid>
 </DockPanel>
</Window>
