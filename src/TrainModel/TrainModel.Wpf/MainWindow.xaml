<Window x:Class="TrainModel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Train Model Console"
        Width="1560" Height="980" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style x:Key="SubCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,1,0,6"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="InsetPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- INPUT / OUTPUT interface row: badge + dot + label + sub-source + value -->
        <DataTemplate x:Key="IoRowTemplate">
            <!-- Label block (left, flexible) + a fixed-width right group holding the
                 badge, dot, and value. The badge sits at a fixed offset so it never
                 overlaps the label; long labels wrap instead of being clipped. -->
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Label}" Foreground="#111827" FontSize="12"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Source}" Foreground="#9CA3AF" FontSize="9"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border VerticalAlignment="Center" CornerRadius="3" Padding="5,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInput}" Value="False">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Direction}" FontSize="9" FontWeight="SemiBold" Foreground="#374151"/>
                    </Border>
                    <Ellipse Width="8" Height="8" Margin="6,0" VerticalAlignment="Center" Fill="#22C55E"/>
                    <TextBlock Text="{Binding Value}" MinWidth="104" TextAlignment="Right"
                               Foreground="#111827" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- severity badge color for the event log -->
        <Style x:Key="SeverityBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="WARN">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="ALERT">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="THE DEBUG EXPRESS / RAILWAY SIMULATOR" Foreground="#9CA3AF" FontSize="9"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Train Model Console" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedHeaderDisplay, StringFormat=[{0}]}"
                                   Foreground="#60A5FA" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="SIM SPEED" Foreground="#9CA3AF" FontSize="9"/>
                    <TextBlock Text="{Binding SpeedMultiplierDisplay}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <Slider Grid.Column="2" Width="130" Minimum="1" Maximum="10" TickFrequency="1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0"
                        Value="{Binding SpeedMultiplier, Mode=TwoWay}"/>
                <Button Grid.Column="3" Content="{Binding PlayPauseLabel}" Width="76" VerticalAlignment="Center"
                        Command="{Binding PlayPauseCommand}"/>
                <Button Grid.Column="4" Content="Reset" Width="66" VerticalAlignment="Center"
                        Command="{Binding ResetCommand}"/>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 1: Telemetry + Running Trains -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Telemetry -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Telemetry Summary" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="#166534"/>
                                </Border>
                            </Grid>
                            <UniformGrid Rows="1" Columns="5" Margin="0,8,0,0">
                                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="ACTUAL SPEED" Style="{StaticResource MetricCaptionStyle}"/>
                                        <TextBlock Text="{Binding ActualSpeedDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="COMMANDED SPEED" Style="{StaticResource MetricCaptionStyle}"/>
                                        <TextBlock Text="{Binding CommandedSpeedDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="COMMANDED AUTHORITY" Style="{StaticResource MetricCaptionStyle}"/>
                                        <TextBlock Text="{Binding AuthorityDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="POWER COMMAND" Style="{StaticResource MetricCaptionStyle}"/>
                                        <TextBlock Text="{Binding PowerCommandDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CABIN TEMP" Style="{StaticResource MetricCaptionStyle}"/>
                                        <TextBlock Text="{Binding CabinTempDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource InsetPanelStyle}" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Position: " Foreground="#6B7280"/>
                                        <Run Text="{Binding PositionDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="   ·   Weight: " Foreground="#6B7280"/>
                                        <Run Text="{Binding TotalWeightDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="   ·   Passengers: " Foreground="#6B7280"/>
                                        <Run Text="{Binding OnboardLoadDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="   ·   Next Station: " Foreground="#6B7280"/>
                                        <Run Text="{Binding NextStationDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="8,2">
                                        <!-- Green when released (normal), amber when applied. -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServiceBrakeKind}" Value="Applied">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ServiceBrakeDisplay, StringFormat=Service Brake: {0}}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServiceBrakeKind}" Value="Applied">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Station Announcement band: full-width, wraps long text -->
                            <Border Style="{StaticResource InsetPanelStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="STATION ANNOUNCEMENT" FontSize="9" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <Border Background="#DBEAFE" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                            <TextBlock Text="CONTROLLER · IN" FontSize="8" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StationAnnouncementDisplay}"
                                               FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Beacon Information band: full-width, room for station + distance + side -->
                            <Border Style="{StaticResource InsetPanelStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="BEACON INFORMATION" FontSize="9" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <Border Background="#DCFCE7" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                            <TextBlock Text="TRACK · IN" FontSize="8" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BeaconDisplay}"
                                               FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Passenger Exchange band: enter alighting count, run exchange, show result -->
                            <Border Style="{StaticResource InsetPanelStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="PASSENGER EXCHANGE" FontSize="9" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alighting:" VerticalAlignment="Center" Foreground="#374151" Margin="0,0,6,0"/>
                                        <TextBox Width="60" VerticalContentAlignment="Center"
                                                 Text="{Binding AlightingCount, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Exchange Passengers" Margin="8,0,0,0"
                                                Command="{Binding ExchangePassengersCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BoardedAlightedDisplay}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#111827" Margin="0,4,0,0"/>
                                    <TextBlock Text="Boarding is drawn from the Track Model's passenger demand (capped by capacity); the Train Model decides who alights."
                                               FontSize="9" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Running Trains -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Running Trains" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="#166534"/>
                                </Border>
                            </Grid>
                            <ListBox ItemsSource="{Binding Roster}" Margin="0,8,0,0"
                                     SelectedValuePath="TrainId"
                                     SelectedValue="{Binding SelectedTrainId, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TrainId}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                                        <TextBlock Text=" · " Foreground="#9CA3AF"/>
                                                        <TextBlock Text="{Binding LineName}" Foreground="#1D4ED8"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#6B7280">
                                                        <Run Text="Pos "/><Run Text="{Binding PositionDisplay, Mode=OneWay}"/>
                                                        <Run Text=" · "/><Run Text="{Binding SpeedDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="3" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Faulted">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="EBraked">
                                                                    <Setter Property="Background" Value="#FECACA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="#374151"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Select a train to inspect its state, block position, and speed."
                                       Style="{StaticResource SubCaptionStyle}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 2: Track IF | Controller IF | Config -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Track Model Interface" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Command inputs from physical block + motion outputs" Style="{StaticResource SubCaptionStyle}"/>
                            <ItemsControl ItemsSource="{Binding TrackRows}" ItemTemplate="{StaticResource IoRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Train Controller Interface" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Cab commands and hardware feedback statuses" Style="{StaticResource SubCaptionStyle}"/>
                            <ItemsControl ItemsSource="{Binding ControllerRows}" ItemTemplate="{StaticResource IoRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Train Configuration Specs" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Physical constraints and sizing characteristics" Style="{StaticResource SubCaptionStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Consist Size" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConsistDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="1" Text="Total Length" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LengthDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="2" Text="Total Height" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HeightDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="3" Text="Total Empty Weight" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EmptyWeightDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="4" Text="Per-Module Empty Weight" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PerModuleWeightDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="5" Text="Max Speed" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MaxSpeedDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="6" Text="Max Power" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MaxPowerDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="7" Text="Max Accel Limit" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MaxAccelDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="8" Text="Max Decel (svc / emer)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding MaxDecelDisplay}" Style="{StaticResource ValueStyle}"/>
                                <TextBlock Grid.Row="9" Text="Max Pass. Cap. / Crew" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MaxCapacityCrewDisplay}" Style="{StaticResource ValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 3: Murphy/Passenger | Event Log -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Murphy & Passenger -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Murphy &amp; Passenger Controls" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="FAULT INJECTION COMMANDS" Foreground="#6B7280" FontSize="9" Margin="0,8,0,4"/>
                            <UniformGrid Rows="1" Columns="3">
                                <Button Content="ENGINE FAIL" Command="{Binding ToggleEngineFailureCommand}" Margin="0,0,4,0"/>
                                <Button Content="BRAKE FAIL" Command="{Binding ToggleBrakeFailureCommand}" Margin="0,0,4,0"/>
                                <Button Content="SIGNAL FAIL" Command="{Binding ToggleSignalFailureCommand}"/>
                            </UniformGrid>
                            <UniformGrid Rows="1" Columns="3" Margin="0,4,0,0">
                                <!-- Each pill is grayed (Idle) by default and turns red (Active) when its failure is on. -->
                                <Border CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineStateKind}" Value="Active">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding EngineStateDisplay}" FontSize="9" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EngineStateKind}" Value="Active">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BrakeStateKind}" Value="Active">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BrakeStateDisplay}" FontSize="9" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BrakeStateKind}" Value="Active">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="3" Padding="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignalStateKind}" Value="Active">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SignalStateDisplay}" FontSize="9" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SignalStateKind}" Value="Active">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource InsetPanelStyle}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PASSENGER EMERGENCY BRAKE" FontSize="9" FontWeight="SemiBold" Foreground="#374151"/>
                                        <TextBlock Text="{Binding PassengerEBrakeRequestDisplay}" FontSize="10" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PassengerEBrakeKind}" Value="Pending">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PassengerEBrakeKind}" Value="Engaged">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PassengerEBrakeStateDisplay}" FontSize="9" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PassengerEBrakeKind}" Value="Pending">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PassengerEBrakeKind}" Value="Engaged">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Disabled while a request is already pending/engaged for the selected train;
                                 re-enables per train (and after reset). -->
                            <Button Content="ACTIVATE PASSENGER EMERGENCY BRAKE REQUEST" Margin="0,8,0,0"
                                    Background="#DC2626" Foreground="White" FontWeight="SemiBold" MinHeight="32"
                                    IsEnabled="{Binding CanRequestPassengerEBrake}"
                                    Command="{Binding PassengerEmergencyBrakeCommand}"/>
                            <Button Content="RESET" Margin="0,4,0,0" MinHeight="30"
                                    Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Event Log -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Event &amp; Core I/O Log" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#F3F4F6" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="Live events" FontSize="9" Foreground="#6B7280"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Real-time transaction history between Train and Control modules"
                                       Style="{StaticResource SubCaptionStyle}"/>
                            <ItemsControl ItemsSource="{Binding EventLog}" MaxHeight="230">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#9CA3AF"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Style="{StaticResource SeverityBadgeStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="SemiBold" Foreground="#374151"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontWeight="SemiBold"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#4B5563"
                                                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
