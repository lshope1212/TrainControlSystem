<Window x:Class="CTC.TestUI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500">

    <Grid Margin="6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Margin="4,0,4,6">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="External Module Simulator: runs beside CTC.Wpf, sends shared contract messages into the real CTC and captures what CTC sends to the Track Controller."
                       Foreground="#6B7280"
                       TextWrapping="Wrap"/>
        </StackPanel>


        <!-- ==================================================
             1. SIMULATED INPUTS (other modules -> CTC)
             ================================================== -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Simulated Inputs to CTC">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="Track Controller -> CTC">
                        <StackPanel>

                            <!-- ============================
                                 BLOCK STATUS INPUT
                                 ============================ -->

                            <TextBlock Text="Block Status"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Block ID -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Block ID:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding BlockStatusInput.BlockId,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>


                                <!-- Occupancy -->

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Occupancy:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding BlockStatusInput.OccupancyOptions}"
                                          SelectedItem="{Binding BlockStatusInput.SelectedOccupancy}"
                                          Margin="0,0,0,6"/>


                                <!-- Signal -->

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Signal:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding BlockStatusInput.SignalOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding BlockStatusInput.SelectedSignal}"
                                          Margin="0,0,0,6"/>


                                <!-- Switch -->

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Switch:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding BlockStatusInput.SwitchOptions}"
                                          SelectedItem="{Binding BlockStatusInput.SelectedSwitch}"
                                          Margin="0,0,0,6"/>


                                <!-- Crossing -->

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Crossing:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding BlockStatusInput.CrossingOptions}"
                                          SelectedItem="{Binding BlockStatusInput.SelectedCrossing}"
                                          Margin="0,0,0,6"/>


                                <!-- Maintenance -->

                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Text="Maintenance:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <ComboBox Grid.Row="5"
                                          Grid.Column="1"
                                          ItemsSource="{Binding BlockStatusInput.MaintenanceOptions}"
                                          SelectedItem="{Binding BlockStatusInput.SelectedMaintenance}"/>

                            </Grid>

                            <Button Content="Send Block Status"
                                    Command="{Binding BlockStatusInput.SendCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"/>

                            <TextBlock Text="{Binding BlockStatusInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>


                            <!-- ============================
                                 FUTURE INPUT
                                 ============================ -->

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Track Model -> CTC">
                        <StackPanel>
                            <TextBlock Text="Track Layout" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Send Sample Layout"
                                        Command="{Binding TrackLayoutInput.SendSampleLayoutCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TrackLayoutInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>

                            <!-- ============================
                                 TICKET SALES INPUT
                                 ============================ -->

                            <TextBlock Text="Ticket Sales"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Line:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,6"/>

                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding TicketSalesInput.LineOptions}"
                                          SelectedItem="{Binding TicketSalesInput.SelectedLine}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Tickets Sold / Hour:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding TicketSalesInput.TicketsPerHourText,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                            </Grid>

                            <Button Content="Send Ticket Sales"
                                    Command="{Binding TicketSalesInput.SendCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"/>

                            <TextBlock Text="{Binding TicketSalesInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="System -> CTC">
                        <StackPanel>
                            <TextBlock Text="System Time (simulated shared clock, 1x)" FontWeight="SemiBold"/>

                            <!-- Current clock value and state -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Current Time:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SystemTimeInput.CurrentTimeDisplay}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding SystemTimeInput.ClockState}"
                                           Foreground="#4B5563"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Set the clock (only while paused) -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox Text="{Binding SystemTimeInput.TimeText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SystemTimeInput.IsPaused}"
                                         Width="90"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="Set Time"
                                        Command="{Binding SystemTimeInput.SetTimeCommand}"/>
                            </StackPanel>

                            <!-- Run controls -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Start"
                                        Command="{Binding SystemTimeInput.StartCommand}"/>
                                <Button Content="Pause"
                                        Command="{Binding SystemTimeInput.PauseCommand}"/>
                                <Button Content="Reset"
                                        Command="{Binding SystemTimeInput.ResetCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SystemTimeInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>


        <!-- ==================================================
             2. CAPTURED CTC OUTPUTS (CTC -> fake Track Controller)
             ================================================== -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Captured CTC Outputs (received on the Track Controller pipe)">
            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Clear Captured Outputs"
                            Command="{Binding Outputs.ClearCommand}"/>
                    <TextBlock Text="{Binding Outputs.Messages.Count, StringFormat={}{0} captured}"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Outputs.Messages}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="40"/>
                        <DataGridTextColumn Header="Captured At" Binding="{Binding CapturedAt, StringFormat=HH:mm:ss.fff}" Width="90"/>
                        <DataGridTextColumn Header="Message Type" Binding="{Binding MessageType}" Width="210"/>
                        <DataGridTextColumn Header="Payload" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </GroupBox>


        <!-- ==================================================
             3. COMMUNICATION STATUS
             ================================================== -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Communication Status">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Communication.CtcPipeName, StringFormat=CTC endpoint ({0}):}"
                           FontWeight="SemiBold"
                           Margin="0,0,8,4"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Communication.CtcEndpointStatus}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1"
                           Text="Fake Track Controller listener:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Communication.TrackControllerListenerStatus}"
                           TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

    </Grid>

</Window>
