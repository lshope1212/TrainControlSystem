<Window x:Class="CTC.TestUI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500">

    <Grid Margin="6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Margin="4,0,4,6">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Developer harness: real CTC.Core, simulated module inputs, captured outputs (no inter-process communication)."
                       Foreground="#6B7280"/>
        </StackPanel>


        <!-- ==================================================
             1. SIMULATED INPUTS (other modules -> CTC)
             ================================================== -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Simulated Inputs">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="Track Controller Inputs">
                        <StackPanel>
                            <TextBlock Text="Block Status (BlockStatusMessage): not implemented yet"
                                       Style="{StaticResource PlaceholderTextStyle}"/>
                            <TextBlock Text="Train Authorization Status (TrainAuthorizationStatusMessage): not implemented yet"
                                       Style="{StaticResource PlaceholderTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Track Model Inputs">
                        <StackPanel>
                            <TextBlock Text="Track Layout (TrackLayoutMessage)" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Apply Sample Layout"
                                        Command="{Binding TrackLayoutInput.ApplySampleLayoutCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TrackLayoutInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>

                            <TextBlock Text="Ticket Sales (TicketSalesMessage): not implemented yet"
                                       Style="{StaticResource PlaceholderTextStyle}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="System Inputs">
                        <StackPanel>
                            <TextBlock Text="System Time (simulated shared clock)" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Text="{Binding SystemTimeInput.TimeText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="Set Time"
                                        Command="{Binding SystemTimeInput.ApplyCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SystemTimeInput.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>


        <!-- ==================================================
             2. CAPTURED CTC OUTPUTS (CTC -> other modules)
             ================================================== -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Captured CTC Outputs (RecordingMessageSender)">
            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Clear Captured Outputs"
                            Command="{Binding Outputs.ClearCommand}"/>
                    <TextBlock Text="{Binding Outputs.Messages.Count, StringFormat={}{0} captured}"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Outputs.Messages}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="40"/>
                        <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt, StringFormat=HH:mm:ss.fff}" Width="90"/>
                        <DataGridTextColumn Header="Message Type" Binding="{Binding MessageType}" Width="210"/>
                        <DataGridTextColumn Header="Contents" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </GroupBox>


        <!-- ==================================================
             3. DISPATCHER / CTC ACTIONS
             ================================================== -->
        <GroupBox Grid.Row="2" Grid.Column="0" Header="Dispatcher / CTC Actions">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="Block Maintenance">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Block ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding BlockMaintenanceAction.BlockId, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"/>
                                <Button Content="Close Block"
                                        Command="{Binding BlockMaintenanceAction.CloseBlockCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BlockMaintenanceAction.Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Future Actions">
                        <TextBlock Text="Reopen block, switch position request, movement request, dispatching, routing and suggested speed/authority will be added as CTC.Core implements them."
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   TextWrapping="Wrap"/>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>


        <!-- ==================================================
             4. INTERNAL CTC STATE (CtcSystemState)
             ================================================== -->
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Internal CTC State (CtcSystemState)">
            <DockPanel>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding State.SystemTime, StringFormat=System Time: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding State.LineCount, StringFormat=Lines: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding State.BlockCount, StringFormat=Blocks: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding State.ScheduledTrainCount, StringFormat=Scheduled: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding State.DispatchQueueCount, StringFormat=Queued: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding State.DispatchedTrainCount, StringFormat=Dispatched: {0}}"/>
                </WrapPanel>

                <DataGrid ItemsSource="{Binding State.Blocks}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding LineId}" Width="70"/>
                        <DataGridTextColumn Header="Block" Binding="{Binding BlockId}" Width="60"/>
                        <DataGridTextColumn Header="Occupancy" Binding="{Binding Occupancy}" Width="90"/>
                        <DataGridTextColumn Header="Requested Maint." Binding="{Binding RequestedMaintenance}" Width="120"/>
                        <DataGridTextColumn Header="Switch" Binding="{Binding Switch}" Width="80"/>
                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="80"/>
                        <DataGridTextColumn Header="Crossing" Binding="{Binding Crossing}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </GroupBox>

    </Grid>

</Window>
