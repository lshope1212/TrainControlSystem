<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer test harness for CTC.Core. Must never reference CTC.Wpf (or vice versa),
    and must never use real inter-process communication.
  -->

  <ItemGroup>
    <ProjectReference Include="..\CTC.Core\CTC.Core.csproj" />
    <ProjectReference Include="..\..\Shared\TrainControl.Contracts\TrainControl.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
