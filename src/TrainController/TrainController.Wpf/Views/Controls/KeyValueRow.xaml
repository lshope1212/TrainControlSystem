<UserControl x:Class="TrainController.Wpf.Views.Controls.KeyValueRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Label left (muted), value right (tone-colored), as in the wireframes' status cards. -->
    <DockPanel Margin="0,3">
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource KeyLabelText}"
                   Margin="0,0,12,0"/>
        <TextBlock DataContext="{Binding Display, ElementName=Root}"
                   Style="{StaticResource ToneText}"
                   HorizontalAlignment="Right"
                   TextAlignment="Right"
                   TextWrapping="Wrap"/>
    </DockPanel>
</UserControl>
