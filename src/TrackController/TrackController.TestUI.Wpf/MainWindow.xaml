<Window x:Class="TrackController.TestUI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Controller Test UI"
        Width="1450"
        Height="850"
        MinWidth="1250"
        MinHeight="720"
        Background="#F3F4F6"
        Foreground="#1F2937"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="Inset" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#6B7280"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Track Controller · Test UI" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Simulates CTC and Track Model. Configure PLC, PC/Pi execution, and Pause/Resume in the controller window."
                           Foreground="#D1D5DB"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DataStatus}" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Inset}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Margin="18,0,10,0" VerticalAlignment="Center">
                        <CheckBox Content="Repeat sent inputs every second" IsChecked="{Binding ShouldRepeatInputs}"/>
                        <TextBlock Text="{Binding RepeatDescription}"
                                   Style="{StaticResource Hint}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Clear test inputs"
                            Command="{Binding ClearInputsCommand}"
                            VerticalAlignment="Center"
                            ToolTip="Stops repeats, cancels the submitted movement, and clears the test drafts. It does not reset the controller."/>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
                            <TextBlock Text="1. Track feedback" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Simulate what Track Model reports to the controller."
                                       Style="{StaticResource Hint}"
                                       Margin="0,0,0,6"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,1,0,0"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="{Binding FeedbackDraftStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           Margin="0,0,0,6"/>
                                <Button Content="Send feedback"
                                        Command="{Binding ApplyFeedbackCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="12,0,12,12">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Inset}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Load preset"
                                                Command="{Binding LoadScenarioCommand}"
                                                Margin="8,0,0,0"
                                                ToolTip="Fills both editor tabs without sending. Select Send feedback to apply the values."/>
                                        <ComboBox ItemsSource="{Binding Scenarios}"
                                                  SelectedItem="{Binding Scenario}"
                                                  ToolTip="{Binding ScenarioDescription}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TabControl Padding="6" BorderBrush="#D1D5DB">
                                <TabItem Header="Blocks">
                                    <DataGrid ItemsSource="{Binding FeedbackRows}" IsReadOnly="False" RowHeight="29">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Block"
                                                                Binding="{Binding BlockId}"
                                                                IsReadOnly="True"
                                                                Width="50"/>
                                            <DataGridTemplateColumn Header="Occupancy" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox MinHeight="24"
                                                                  Padding="3,0"
                                                                  ItemsSource="{Binding DataContext.Occupancies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Occupancy, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Fault" Width="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsFaulted, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Reserved" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsThreeState="True"
                                                                  IsChecked="{Binding IsReserved, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="Checked: reserved by CTC. Empty: not reserved. Dash: unknown."
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Equipment">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="2,6">
                                            <TextBlock Text="Report actual equipment state; sending a command does not change these values."
                                                       Style="{StaticResource Hint}"
                                                       Margin="0,0,0,10"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Switch"/>
                                                    <ComboBox ItemsSource="{Binding SwitchIds}"
                                                              SelectedItem="{Binding FeedbackSwitch}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Actual position"/>
                                                    <ComboBox ItemsSource="{Binding SwitchPositions}"
                                                              SelectedItem="{Binding ReportedSwitch}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Signal"/>
                                                    <ComboBox ItemsSource="{Binding SignalIds}"
                                                              SelectedItem="{Binding FeedbackSignal}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Actual aspect"/>
                                                    <ComboBox ItemsSource="{Binding SignalStates}"
                                                              SelectedItem="{Binding ReportedSignal}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Crossing"/>
                                                    <ComboBox ItemsSource="{Binding CrossingIds}"
                                                              SelectedItem="{Binding FeedbackCrossing}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,10">
                                                    <TextBlock Style="{StaticResource Label}" Text="Actual state"/>
                                                    <ComboBox ItemsSource="{Binding CrossingStates}"
                                                              SelectedItem="{Binding ReportedCrossing}"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
                            <TextBlock Text="2. CTC requests" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Request movement using the track feedback you sent."
                                       Style="{StaticResource Hint}"
                                       Margin="0,0,0,10"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,1,0,0"
                                Padding="12,9">
                            <WrapPanel>
                                <Button Content="Send movement request"
                                        Command="{Binding SendMovementCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Cancel request"
                                        Command="{Binding CancelMovementCommand}"
                                        HorizontalAlignment="Left"/>
                            </WrapPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,0,12,12">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Style="{StaticResource Label}" Text="Occupied target block"/>
                                        <ComboBox ItemsSource="{Binding BlockIds}"
                                                  SelectedItem="{Binding TargetBlock}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Style="{StaticResource Label}" Text="Train label (optional)"/>
                                        <TextBox Text="{Binding TrainLabel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Style="{StaticResource Label}" Text="Suggested speed (mph)"/>
                                        <TextBox Text="{Binding SuggestedSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Style="{StaticResource Label}" Text="Requested authority (ft)"/>
                                        <TextBox Text="{Binding RequestedAuthority, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource Label}" Text="Front offset in target block (ft)"/>
                                    <TextBox Text="{Binding FrontOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Style="{StaticResource Label}"
                                               Text="Next blocks in route, in order (comma-separated)"/>
                                    <TextBox Text="{Binding RequestedPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Expander Header="Switch entry (if target is a switch)" Margin="0,0,0,10">
                                    <StackPanel Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Style="{StaticResource Label}"
                                                       Text="Block the train enters from"/>
                                            <TextBox Text="{Binding EntryBlock, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Separator Margin="0,14,0,10"/>
                                <Expander Header="Switch request" Margin="0,0,0,12">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Requests a switch change. Report its actual position in Track feedback separately."
                                                   Style="{StaticResource Hint}"
                                                   Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Style="{StaticResource Label}" Text="Switch"/>
                                                <ComboBox ItemsSource="{Binding SwitchIds}"
                                                          SelectedItem="{Binding SwitchTarget}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Style="{StaticResource Label}" Text="Requested position"/>
                                                <ComboBox ItemsSource="{Binding SwitchPositions}"
                                                          SelectedItem="{Binding RequestedSwitch}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Content="Send switch request"
                                                Command="{Binding SendSwitchCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Block closure request">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Ask the controller to close or reopen a block."
                                                   Style="{StaticResource Hint}"
                                                   Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Style="{StaticResource Label}" Text="Block"/>
                                                <ComboBox ItemsSource="{Binding BlockIds}"
                                                          SelectedItem="{Binding MaintenanceTarget}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Style="{StaticResource Label}" Text="Requested state"/>
                                                <ComboBox ItemsSource="{Binding MaintenanceStates}"
                                                          SelectedItem="{Binding RequestedMaintenance}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Content="Send closure request"
                                                Command="{Binding SendMaintenanceCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="3. Controller response" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Read-only results returned by the running controller."
                                       Style="{StaticResource Hint}"
                                       Margin="0,0,0,10"/>
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,14">
                                <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" LineHeight="21"/>
                            </Border>
                            <TextBlock Text="Equipment" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Command = controller output. Reported = Track Model input."
                                       Style="{StaticResource Hint}"
                                       Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Equipment}" MinHeight="175" MaxHeight="255">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding Equipment}" Width="*"/>
                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="85"/>
                                    <DataGridTextColumn Header="Reported" Binding="{Binding Feedback}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander Header="Connection details" Margin="0,14,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Connection}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding LastReceipt}"
                                               Style="{StaticResource Hint}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
