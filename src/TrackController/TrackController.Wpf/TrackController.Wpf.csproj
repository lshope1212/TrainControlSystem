<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TrackController.Runtime\TrackController.Runtime.csproj" />
    <ProjectReference Include="..\TrackController.Core\TrackController.Core.csproj" />
    <ProjectReference Include="..\..\Shared\TrainControl.Contracts\TrainControl.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\TrainControl.Common\TrainControl.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);TRACK_CONTROLLER_MAP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\CTC\CTC.Wpf\Layout\TerritoryLayoutProvider.cs" Link="Layout\TerritoryLayoutProvider.cs" />
    <Compile Include="..\..\CTC\CTC.Wpf\Layout\TerritoryBlockPlacement.cs" Link="Layout\TerritoryBlockPlacement.cs" />
    <EmbeddedResource Include="..\..\TrackModel\SampleLayouts\course-lines.json" LogicalName="TrackController.CourseLines.json" />
  </ItemGroup>

</Project>
