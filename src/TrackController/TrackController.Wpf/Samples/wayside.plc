# TERRITORY VITAL CONTROL
# Every input, intermediate and output is one Boolean: true or false.
# Words encode SI values in millionths; bit zero is least significant.
# Only AND, OR and NOT gates are used. All comparator and adder gates are explicit.
plc boolean_v1

# Request and per-block interlocking. Inputs are individual measured facts.
session_ok = running and not maintenance and request_fresh and not request_retired and origin_occupied and not route_conflict
feedback_ok = feedback_fresh and not block_unknown and not block_faulted
selected_exit = (reported_normal and exit_normal) or (reported_reverse and exit_reverse)
selected_entry = (reported_normal and entry_normal) or (reported_reverse and entry_reverse)
direction_ok = ((not has_next) or ((has_stem and ((entry_stem and selected_exit) or (exit_stem and selected_entry))) or (not has_stem and selected_exit)))
alignment_ok = not has_switch or (switch_known and switch_confirmed and direction_ok)
entry_allowed = not block_closed and (is_origin or (block_clear and not block_pending))
signal_ok = not has_signal or (signal_proceed and not manual_red)
crossing_ok = not has_crossing or crossing_closed
