# Fold each switch-protection block into zone_ok, then select its command.
zone_ok = zone_ok_in and feedback_fresh and block_clear and not block_faulted and reserved_known and not reserved
switch_move = switch_request_known and zone_ok and not movement_locked and (running or maintenance)
switch_normal = requested_normal

# Fold every crossing approach, then include routes and manual protection.
crossing_needed = crossing_needed_in or not feedback_fresh or not block_clear or block_faulted
crossing_close = crossing_needed or active_route or manual_crossing_close or not running or maintenance

# A requested closure completes only after fresh, clear occupancy feedback.
closure_closed = feedback_fresh and block_clear
