<Window x:Class="TrackController.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TrackController.Wpf.Controls"
        Title="Track Controller"
        Width="1600"
        Height="900"
        MinWidth="800"
        MinHeight="540"
        Background="#F3F4F6"
        Foreground="#1F2937"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="TerritoryScope" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TabIndex}" Value="3">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="Inset" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="#F3F4F6">
        <Border DockPanel.Dock="Top"
                Background="#1F2937"
                Height="68"
                Padding="16,8"
                BorderThickness="0,0,0,4"
                BorderBrush="{Binding LineAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TRACK CONTROLLER" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Wayside control &amp; monitoring" Foreground="#D1D5DB" FontSize="11"/>
                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Controller setup" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="All wayside territories" Foreground="#D1D5DB" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TerritoryScope}">
                    <Border Background="{Binding LineAccentBrush}"
                            CornerRadius="3"
                            Padding="7,1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedMapLine}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding SelectedMapTerritory.Name}" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom"
                Background="#F9FAFB"
                BorderThickness="0,1,0,0"
                BorderBrush="#D1D5DB"
                Padding="12,6">
            <TextBlock Text="{Binding Connection}"
                       FontSize="11"
                       Foreground="#6B7280"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Connection}"/>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wayside movement and equipment"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DataStatus}" Style="{StaticResource Hint}" Margin="0,4,12,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Maintenance mode" IsChecked="{Binding IsMaintenanceMode}"
                      VerticalAlignment="Center" Margin="12,0"
                      ToolTip="Allows setup changes and manual equipment commands; withholds automatic movement authority."/>
        </Grid>
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,1"
                Padding="12,7"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <DockPanel Margin="8,0,8,8">
                        <StackPanel DockPanel.Dock="Top" Background="#F9FAFB" Style="{StaticResource TerritoryScope}">
                            <WrapPanel Margin="10,8">
                                <TextBlock Text="Line" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding MapLines}" SelectedItem="{Binding SelectedMapLine}" MinWidth="120" Margin="0,0,14,0"/>
                                <TextBlock Text="Territory" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding MapTerritories}" SelectedItem="{Binding SelectedMapTerritory}" DisplayMemberPath="Name" MinWidth="210"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding MapDescription}" Margin="10,0,10,6" Style="{StaticResource Hint}"/>
                        </StackPanel>
            <TabControl
                        SelectedIndex="{Binding TabIndex}"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        Padding="12">
                <TabItem Header="Territory map">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="315"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="10,4">
                            <TextBlock Text="● Clear" Foreground="#368653" Margin="0,0,12,0"/>
                            <TextBlock Text="● Occupied" Foreground="#C84036" Margin="0,0,12,0"/>
                            <TextBlock Text="● Unknown" Foreground="#6B7280" Margin="0,0,12,0"/>
                            <TextBlock Text="□ Maintenance" Foreground="#BB721F" Margin="0,0,12,0"/>
                                                        <TextBlock Text="╲ Crossing" Foreground="#344256" Margin="0,0,12,0"/>
                            <TextBlock Text="◇ Switch · ○ Station · ⇢ Handoff" Foreground="#6D28D9"/>
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,8">
                            <WrapPanel>
                                <Button Content="Fit territory" Command="{x:Static controls:TerritoryMap.FitCommand}" CommandTarget="{Binding ElementName=TrackMap}" Padding="10,4"/>
                                <Button Content="−" Command="{x:Static controls:TerritoryMap.ZoomOutCommand}" CommandTarget="{Binding ElementName=TrackMap}" Padding="12,4" Margin="6,0,0,0"/>
                                <Button Content="+" Command="{x:Static controls:TerritoryMap.ZoomInCommand}" CommandTarget="{Binding ElementName=TrackMap}" Padding="12,4" Margin="4,0,10,0"/>
                                <TextBlock Text="Scroll to zoom · drag to pan · click a block" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding MapHandoffs}" TextWrapping="Wrap" FontSize="11" Foreground="#6D28D9" Margin="0,6,0,0"/>
                        </StackPanel>
                        <controls:TerritoryMap x:Name="TrackMap" Blocks="{Binding MapBlocks}" NetworkBlocks="{Binding Blocks}"
                                               SelectedBlockId="{Binding SelectedBlockId}" Margin="6" MinHeight="160"/>
</DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding SelectedBlockId, StringFormat=Selected block • {0}}"
                                   Style="{StaticResource PanelTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="{Binding SelectedBlock.StationName}" TextWrapping="Wrap" Foreground="#6D28D9" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Controller" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedExecutionTarget}"
                                               TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Occupancy" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedBlock.Occupancy}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Maintenance" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedBlock.Maintenance}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <Separator Background="#E5E7EB"/>
                                <DockPanel Margin="0,8,0,7">
                                    <TextBlock Text="Suggested speed (mph)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.SuggestedSpeed, TargetNullValue=—}"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock Text="Authorized speed (mph)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.AuthorizedSpeed, TargetNullValue=—}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Authority from block entry (ft)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.AuthorizedAuthority, TargetNullValue=—}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <Border Background="#F3F4F6" Padding="8">
                                    <TextBlock Text="{Binding SelectedLimit}" Foreground="#2D61A8"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
                </TabItem>
                <TabItem Header="Movement permissions">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="CTC movement requests · selected territory"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding TerritoryMovements}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CTC label" Binding="{Binding Train}" Width="100"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="95"/>
                                <DataGridTextColumn Header="Requested path" Binding="{Binding Path}" Width="210"/>
                                <DataGridTextColumn Header="Suggested mph"
                                                    Binding="{Binding SuggestedSpeed}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Suggested authority (ft)"
                                                    Binding="{Binding RequestedAuthority}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="Authorized mph"
                                                    Binding="{Binding AuthorizedSpeed}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Authorized limit (ft)"
                                                    Binding="{Binding AuthorizedAuthority}"
                                                    Width="145"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                <DataGridTextColumn Header="Restriction reason"
                                                    Binding="{Binding Reason}"
                                                    Width="*"
                                                    MinWidth="230"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Wayside equipment">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,16,0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Equipment · selected territory"
                                       Style="{StaticResource SectionHeading}"/>
                            <DataGrid ItemsSource="{Binding TerritoryEquipment}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding Equipment}" Width="170"/>
                                    <DataGridTextColumn Header="Block" Binding="{Binding Block}" Width="95"/>
                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="100"/>
                                    <DataGridTextColumn Header="Reported" Binding="{Binding Feedback}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Manual equipment controls" Style="{StaticResource SectionHeading}"/>
                                <StackPanel>

                                    <TextBlock Text="Maintenance mode holds movement on every territory. Switch protection blocks must be clear, current and unreserved. Track Model reports the actual equipment position separately."
                                               Style="{StaticResource Hint}"
                                               Margin="0,0,0,10"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Style="{StaticResource Label}" Text="Block / equipment"/>
                                            <ComboBox ItemsSource="{Binding MapBlockIds}"
                                                      SelectedItem="{Binding ManualTarget}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Style="{StaticResource Label}" Text="Command"/>
                                            <ComboBox ItemsSource="{Binding ManualActions}"
                                                      SelectedItem="{Binding ManualAction}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Content="Send manual command"
                                            Command="{Binding SendManualCommand}"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding ManualCommandResult}"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Controller setup">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Layout" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox ItemsSource="{Binding SetupChoices}" SelectedItem="{Binding SelectedSetup}"
                                      IsEnabled="{Binding CanEditSetup}" Width="280"
                                      ToolTip="Choose a course layout or open a saved setup."/>
                            <Button Content="Load layout" Command="{Binding LoadSetupCommand}"
                                    IsEnabled="{Binding CanEditSetup}" Margin="10,0,0,0"
                                    ToolTip="Loads the selected layout, territory assignments and PLC. Requires maintenance mode after initial startup."/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="250"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="3*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Wayside territories" Style="{StaticResource SectionHeading}"/>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Label Content="Line" Target="{Binding ElementName=SetupLineFilter}" VerticalAlignment="Center" Padding="0,0,8,0"/>
                                    <ComboBox x:Name="SetupLineFilter" ItemsSource="{Binding SetupLines}"
                                              SelectedItem="{Binding SelectedSetupLine}" MinWidth="130" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <ListBox x:Name="SetupTerritories" ItemsSource="{Binding FilteredExecutionRows}"
                                         SelectedItem="{Binding SelectedPlcTerritory}" BorderBrush="#E5E7EB"
                                         Background="#F9FAFB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="10,7"/>
                                            <Setter Property="ToolTip" Value="{Binding Blocks}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AssignmentSummary}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                                    <Setter Property="Foreground" Value="#9A5B06"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding BlockSummary}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedPlcTerritory.Name, TargetNullValue=Select a territory}" Style="{StaticResource SectionHeading}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedPlcTerritory.AppliedDescription}" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                                    <StackPanel IsEnabled="{Binding CanEditExecution}">
                                        <TextBlock Text="Run this territory on" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="SetupTarget" ItemsSource="{Binding SelectedPlcTerritory.Targets}"
                                                  SelectedItem="{Binding SelectedPlcTerritory.Target, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="160" HorizontalAlignment="Left"/>
                                        <Grid x:Name="SetupPiEndpoint" Margin="0,14,0,0"
                                              Visibility="{Binding SelectedPlcTerritory.IsPi, Converter={StaticResource VisibleWhenTrue}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Pi IP address" Style="{StaticResource Label}"/>
                                                <TextBox Text="{Binding SelectedPlcTerritory.Host, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Use the Pi IP, or 127.0.0.1 for local testing."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Port" Style="{StaticResource Label}"/>
                                                <TextBox Text="{Binding SelectedPlcTerritory.Port, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="Enter maintenance mode to edit assignments." Foreground="#9A5B06" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEditExecution}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Expander x:Name="SetupAdvanced" Header="Advanced" Margin="0,22,0,0">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="PLC program" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{Binding SelectedPlcName}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="SetupPlcStatus" Text="{Binding PlcSummary}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                            <Button Content="Replace selected PLC…" Command="{Binding LoadPlcCommand}"
                                                    IsEnabled="{Binding CanEditSetup}" HorizontalAlignment="Left"
                                                    ToolTip="Replace this territory's PLC in maintenance mode. Save setup to retain the assignment."/>
                                            <Expander Header="View PLC source" Margin="0,10,0,16">
                                                <TextBox Text="{Binding PlcSource, Mode=OneWay}" IsReadOnly="True"
                                                         FontFamily="Consolas" FontSize="12" Height="180" Margin="0,8,0,0"
                                                         VerticalContentAlignment="Top" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                            </Expander>
                                            <Expander Header="Owned blocks" Margin="0,0,0,16">
                                                <TextBlock Text="{Binding SelectedPlcTerritory.Blocks}" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Hint}"/>
                                            </Expander>
                                            <Separator Background="#E5E7EB"/>
                                            <Button Content="Reset all controllers" Command="{Binding ResetControllerCommand}" IsEnabled="{Binding Snapshot.IsMaintenanceMode}"
                                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                                    ToolTip="Requires maintenance mode; clears feedback and requests for all territories. Keeps the applied layout and PLC. Stop Test UI repeats first."/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SetupApply" Content="Apply changes" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyExecutionCommand}" IsEnabled="{Binding CanApplyExecution}"
                                            ToolTip="Apply all edited assignments. Controllers remain in maintenance and require fresh feedback."/>
                                    <Button x:Name="SetupSave" Content="Save setup" Command="{Binding SaveExecutionCommand}"
                                            IsEnabled="{Binding CanSaveExecution}" Margin="0"
                                            ToolTip="Save the applied assignments and PLC choices to the loaded setup file."/>
                                </StackPanel>
                                <TextBlock Text="{Binding ExecutionDraftStatus}" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
