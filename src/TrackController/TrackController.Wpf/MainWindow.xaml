<Window x:Class="TrackController.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TrackController.Wpf.Controls"
        Title="Track Controller"
        Width="1600"
        Height="900"
        MinWidth="1250"
        MinHeight="720"
        Background="#F3F4F6"
        Foreground="#1F2937"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="Inset" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#6B7280"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="#F3F4F6">
        <Border DockPanel.Dock="Top" Background="#1F2937" Height="64" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TRACK CONTROLLER" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Wayside control &amp; monitoring" Foreground="#D1D5DB" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Snapshot.LineName}" Foreground="#D1D5DB" FontSize="10"/>
                    <TextBlock Text="{Binding Snapshot.WaysideId}" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="System time" Foreground="#D1D5DB" FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SimulationTime}"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom"
                Background="#F9FAFB"
                BorderThickness="0,1,0,0"
                BorderBrush="#D1D5DB"
                Padding="12,6">
            <TextBlock Text="{Binding Connection}"
                       FontSize="11"
                       Foreground="#6B7280"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Connection}"/>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Operator controls · receives inputs from CTC and Track Model, or the separate Test UI."
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DataStatus}" Style="{StaticResource Hint}" Margin="0,4,12,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SimulationStatus}" VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding SpeedMultipliers}"
                          SelectedItem="{Binding SpeedMultiplier}"
                          Width="55"
                          ToolTip="Simulation speed multiplier"
                          Margin="0,0,10,0"/>
                <Button Content="{Binding PauseResumeLabel}" Command="{Binding PauseResumeCommand}" MinWidth="82"/>
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,1"
                Padding="12,7"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Height="250" Margin="0,0,0,8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="315"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Background="#F9FAFB" LastChildFill="False">
                            <TextBlock Text="Territory overview" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="● Clear" Foreground="#368653" Margin="0,0,12,0"/>
                                <TextBlock Text="● Occupied" Foreground="#C84036" Margin="0,0,12,0"/>
                                <TextBlock Text="● Unknown" Foreground="#6B7280" Margin="0,0,12,0"/>
                                <TextBlock Text="□ Maintenance" Foreground="#BB721F"/>
                            </StackPanel>
                        </DockPanel>
                        <controls:TerritoryMap Blocks="{Binding Blocks}"
                                               SelectedBlockId="{Binding SelectedBlockId}"
                                               Margin="8"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding SelectedBlockId, StringFormat=Selected block • {0}}"
                                   Style="{StaticResource PanelTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,10">
                                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                           Margin="0,0,0,8">
                                    <TextBlock Text="Execution" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedExecutionTarget}"
                                               TextAlignment="Right"
                                               FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Occupancy" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedBlock.Occupancy}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Maintenance" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedBlock.Maintenance}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Actual speed" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActualSpeed}" TextAlignment="Right"/>
                                </DockPanel>
                                <Separator Background="#E5E7EB"/>
                                <DockPanel Margin="0,8,0,7">
                                    <TextBlock Text="Suggested speed (mph)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.SuggestedSpeed, TargetNullValue=—}"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock Text="Authorized speed (mph)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.AuthorizedSpeed, TargetNullValue=—}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Authorized authority (ft)" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedMovement.AuthorizedAuthority, TargetNullValue=—}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </DockPanel>
                                <Border Background="#F3F4F6" Padding="8">
                                    <TextBlock Text="{Binding SelectedLimit}" Foreground="#2D61A8"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding TabIndex}"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        Padding="12">
                <TabItem Header="Movement permissions">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="CTC movement requests"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Movements}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CTC label" Binding="{Binding Train}" Width="100"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="60"/>
                                <DataGridTextColumn Header="Requested path" Binding="{Binding Path}" Width="135"/>
                                <DataGridTextColumn Header="Suggested mph"
                                                    Binding="{Binding SuggestedSpeed}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Requested ft"
                                                    Binding="{Binding RequestedAuthority}"
                                                    Width="95"/>
                                <DataGridTextColumn Header="Authorized mph"
                                                    Binding="{Binding AuthorizedSpeed}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Authorized ft"
                                                    Binding="{Binding AuthorizedAuthority}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                <DataGridTextColumn Header="Restriction reason"
                                                    Binding="{Binding Reason}"
                                                    Width="*"
                                                    MinWidth="230"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Wayside equipment">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,16,0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Commands and reported equipment state"
                                       Style="{StaticResource SectionHeading}"/>
                            <DataGrid ItemsSource="{Binding Equipment}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding Equipment}" Width="*"/>
                                    <DataGridTextColumn Header="Block" Binding="{Binding Block}" Width="55"/>
                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="100"/>
                                    <DataGridTextColumn Header="Reported" Binding="{Binding Feedback}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Manual equipment controls" Style="{StaticResource SectionHeading}"/>
                                <StackPanel>
                                    <CheckBox Content="Enable maintenance mode"
                                              IsChecked="{Binding IsMaintenanceMode}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="Maintenance mode withholds automatic movement. Equipment protection still applies."
                                               Style="{StaticResource Hint}"
                                               Margin="0,0,0,10"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Style="{StaticResource Label}" Text="Block / equipment"/>
                                            <ComboBox ItemsSource="{Binding BlockIds}"
                                                      SelectedItem="{Binding ManualTarget}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Style="{StaticResource Label}" Text="Command"/>
                                            <ComboBox ItemsSource="{Binding ManualActions}"
                                                      SelectedItem="{Binding ManualAction}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Content="Send manual command"
                                            Command="{Binding SendManualCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Controller setup">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Inset}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <ComboBox ItemsSource="{Binding SampleLines}"
                                                  SelectedItem="{Binding SelectedSampleLine}"
                                                  MinWidth="210"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  ToolTip="Line started by Load sample layout. Other lines load through Load deployment."/>
                                        <Button Content="Load sample layout"
                                                Command="{Binding LoadSampleDeploymentCommand}"
                                                ToolTip="Starts the selected line's sample deployment on the PC. Pause first."/>
                                        <Button Content="Load deployment…" Command="{Binding LoadDeploymentCommand}"/>
                                        <Button Content="Local preview"
                                                Command="{Binding RestoreLocalDemoCommand}"
                                                ToolTip="Return to the original single-controller preview. Pause first."/>
                                        <Button Content="Reset controller"
                                                Command="{Binding ResetControllerCommand}"
                                                ToolTip="Pauses and clears controller feedback and requests, retaining the applied deployment and PLC. Stop Test UI repeats first."/>
                                    </WrapPanel>
                                    <TextBlock Text="Execution setup"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding LayoutDescription}"
                                           Style="{StaticResource Hint}"
                                           Margin="0,0,0,6"
                                           ToolTip="{Binding DeploymentFile}"/>
                                <DataGrid ItemsSource="{Binding ExecutionRows}"
                                          AutoGenerateColumns="False"
                                          MinHeight="95"
                                          MaxHeight="200"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          IsEnabled="{Binding CanEditExecution}"
                                          HeadersVisibility="Column"
                                          RowHeight="42">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Territory" Binding="{Binding Name}" Width="1.2*"/>
                                        <DataGridTextColumn Header="Owned blocks"
                                                            Binding="{Binding Blocks}"
                                                            Width="1.4*"/>
                                        <DataGridTextColumn Header="Observe only"
                                                            Binding="{Binding Neighbors}"
                                                            Width="0.7*"/>
                                        <DataGridTemplateColumn Header="Run on" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Targets}"
                                                              SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                              Padding="4,1"
                                                              MinHeight="26"
                                                              Margin="3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Applied"
                                                            Binding="{Binding AppliedTarget}"
                                                            Width="70"/>
                                        <DataGridTemplateColumn Header="Tunnel address" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsPi}"
                                                             Padding="4,1"
                                                             MinHeight="26"
                                                             Margin="3"
                                                             ToolTip="Windows loopback address for the SSH tunnel, usually 127.0.0.1."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Port" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsPi}"
                                                             Padding="4,1"
                                                             MinHeight="26"
                                                             Margin="3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,8,0,0">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="Apply execution"
                                                Command="{Binding ApplyExecutionCommand}"
                                                IsEnabled="{Binding CanApplyExecution}"
                                                ToolTip="Requires pause. Restarts controllers with these targets; fresh feedback and explicit resume are required."/>
                                        <Button Content="Save applied choices"
                                                Command="{Binding SaveExecutionCommand}"
                                                IsEnabled="{Binding CanSaveExecution}"
                                                ToolTip="Saves applied placement to the loaded deployment JSON. Track map and territory ownership are separate files."/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ExecutionDraftStatus}"
                                               Style="{StaticResource Hint}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                </DockPanel>
                                <TextBlock Text="Pause to change execution. Territory ownership is independent of PC/Pi placement. The separate Test UI sends inputs to this same controller."
                                           Style="{StaticResource Hint}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="Controller logic" Style="{StaticResource SectionHeading}"/>
                                    <ComboBox ItemsSource="{Binding ControllerModes}"
                                              SelectedItem="{Binding ControllerMode}"
                                              IsEnabled="{Binding CanChooseLogic}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="PC and Pi territories run the same loaded PLC. Software logic is an alternate rule evaluator available in the local preview."
                                               Style="{StaticResource Hint}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Snapshot.PlcName}"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,8"/>
                                    <TextBlock Text="{Binding PlcSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Load PLC file…" Command="{Binding LoadPlcCommand}"/>
                                        <Button Content="Load sample PLC" Command="{Binding LoadSamplePlcCommand}"/>
                                    </WrapPanel>
                                    <Separator Margin="0,12,0,12"/>
                                    <TextBlock Text="Local preview layout" Style="{StaticResource SectionHeading}"/>
                                    <Button Content="Load territory…"
                                            Command="{Binding LoadLayoutCommand}"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding CanChooseLogic}"/>
                                </StackPanel>
                            </ScrollViewer>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="PLC source · read only"
                                           Style="{StaticResource SectionHeading}"/>
                                <TextBox Text="{Binding PlcSource, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Background="#F9FAFB"
                                         Padding="12"
                                         VerticalContentAlignment="Top"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
