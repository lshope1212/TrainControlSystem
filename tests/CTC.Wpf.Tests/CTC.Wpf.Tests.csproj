<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the CTC WPF presentation layer (territory layout, view models) and the CTC
    TestUI's sample layout fixture. Windows-only because both projects are WPF.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CTC\CTC.Wpf\CTC.Wpf.csproj" />
    <ProjectReference Include="..\..\src\CTC\CTC.TestUI.Wpf\CTC.TestUI.Wpf.csproj" />
  </ItemGroup>

</Project>
