CTCService ..|> ICTCService
NamedPipeMessageSender ..|> IMessageSender
MainWindowViewModel --|> ViewModelBase
ScheduleBuilderViewModel --|> ViewModelBase
CTCService --> "1" IMessageSender : -_messageSender
CTCService "1" *--> "1" CtcSystemState : +State
CtcSystemState "1" *--> "*" CtcLineState : +Lines {ordered}
CtcLineState "1" *--> "*" CtcBlockState : +Blocks {ordered}
CtcSystemState "1" o--> "*" ScheduledTrain : +ScheduledTrains
CtcSystemState "1" *--> "*" DispatchQueueEntry : +DispatchQueue {ordered}
CtcSystemState "1" *--> "*" DispatchedTrainState : +DispatchedTrains
ScheduledTrain "1" *--> "*" ScheduledRouteBlock : +Route {ordered}
DispatchedTrainState "1" *--> "*" MovementPlanStop : +Stops {ordered}
DispatchedTrainState --> "1" TrainMovementPhase : +Phase
MainWindowViewModel --> "1" ICTCService : -_ctc
ScheduleBuilderViewModel --> "1" ICTCService : -_ctc
MainWindowViewModel "1" *--> "1" ScheduleBuilderViewModel : +ScheduleBuilder
ScheduleBuilderViewModel --> "0..1" ScheduleTemplate : -_template
ScheduleBuilderViewModel ..> ScheduleTemplateConverter : <<use>>
CtcNamedPipeReceiver --> "1" ICTCService : -_ctc
CTCService ..> MovementPlanner : <<use>>
CTCService ..> SpeedPlanner : <<use>>
CTCService ..> AuthorityManager : <<use>>
CTCService ..> RouteManager : <<use>>
CTCService ..> TrainLocationTracker : <<use>>
CTCService ..> DwellTimePolicy : <<use>>
MovementPlanner ..> SpeedPlanner : <<use>>
MovementPlanner ..> MovementPlanStop : <<create>>
MovementPlanner ..> DispatchedTrainState : <<update>>
SpeedPlanner ..> CtcBlockState
AuthorityManager ..> CtcBlockState
RouteManager ..> CtcLineState
TrainLocationTracker ..> DispatchedTrainState : <<update>>
TrainLocationTracker ..> CtcBlockState
DwellTimePolicy ..> CtcBlockState
ScheduleTemplateConverter ..> ScheduleTemplate
ScheduleTemplateConverter ..> ScheduledTrain : <<create>>
CtcNamedPipeReceiver ..> contracts : <<deserialize>>
ICTCService ..> contracts : <<use>>
CTCService ..> contracts : <<send>>

note bottom of DispatchedTrainState
  CurrentBlockId, ActiveRouteBlockIds and the BlockId of
  MovementPlanStop / ScheduledRouteBlock are logical keys
  into CtcBlockState.BlockId, not object references.
end note
@enduml
