													"parentStyle": false,
													"left": 2383,
													"top": 1004,
													"width": 330,
													"height": 44,
													"text": "Nothing is sent or changed; the previous valid\nActive Movement Plan is kept."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP2000166AAAAAAAA",
													"_parent": {
