																	},
																	"propertyLabel": {
																		"$ref": "AAAAAAGioqEHE6O1lETx"
																	}
																},
																{
																	"_type": "UMLLinePartView",
																	"_id": "AAAAAAGiHtZxZwteemVI",
																	"_parent": {
																		"$ref": "AAAAAAGiM30jg6wMvjSZ"
																	},
																	"model": {
																		"$ref": "AAAAAAGiboct0nh9+AlC"
																	},
																	"font": "Arial;13;0",
																	"parentStyle": false,
																	"left": 3480,
																	"top": 81,
																	"width": 1,
																	"height": 7510
																}
															],
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 3383,
															"top": 40,
															"width": 194,
															"height": 7551,
															"nameCompartment": {
																"$ref": "AAAAAAGig0qo+3ycbNND"
															},
															"linePart": {
																"$ref": "AAAAAAGiHtZxZwteemVI"
															}
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGihRup3s60PzZv",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 391,
															"top": 178,
															"width": 612,
															"height": 61,
															"text": "CanExecute = CanApplyTrainPlan():\n    SelectedDispatchedTrain != null && !IsNullOrWhiteSpace(EditedDestinationBlockId)\n// The arrival time is checked when applying, so a bad entry gets an explanation."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGid1B58fbcIAN6",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 1209,
															"top": 2242,
															"width": 591,
															"height": 91,
															"text": "// Work on copies, normalized so the route starts at the current block;\n// commit only after any needed send succeeded.\noffset   = train.ActiveRouteIndex\nrouteIds = train.ActiveRouteBlockIds.Skip(offset).ToList()\nstops    = copy of each train.Stops[i] with RouteIndex = stop.RouteIndex - offset"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGinMAf/VcJuaVZ",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 1209,
															"top": 2920,
															"width": 654,
															"height": 76,
															"text": "routeIds = routeIds.Take(fromIndex).Concat(path.Select(b => b.BlockId)).ToList()\nstops    = stops.Take(stopIndex).ToList()          // later stops are dropped\nstops.Add(new MovementPlanStop { BlockId = destinationBlockId, ArrivalTime = arrivalTime,\n                                 DwellTime = dwellTime, RouteIndex = routeIds.Count - 1 })"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGiB+7XpYTkFJfg",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 3513,
															"top": 3206,
															"width": 724,
															"height": 106,
															"text": "foreach stop: if DwellTimePolicy.Validate(stop.DwellTime) is { } e  return \"{train} at {block}: {e}\"\nfor i = 1 .. stops.Count - 1:\n    if AvailableTravelTime(stops[i-1].DepartureTime, stops[i].ArrivalTime) <= 0\n        return dwell > 0 ? DwellConflictMessage(...) : \"...Times must increase along the route.\"\n    // DepartureTime = ArrivalTime + DwellTime\nreturn null"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGipVw/LhmyFw0H",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 1209,
															"top": 4719,
															"width": 556,
															"height": 46,
															"text": "// Commit: reached only if every check passed and any needed send succeeded.\n// The original schedule is never changed."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGizAsLEZje0HrN",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 3513,
															"top": 6589,
															"width": 577,
															"height": 46,
															"text": "DepartureTimeAfter(train, n) = (n == 0 && train.ReadyToDepartTime is { } ready)\n                               ? ready : train.Stops[n].DepartureTime"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGi01yKGb7Zjd9T",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
															},
