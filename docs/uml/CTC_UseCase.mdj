												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000r8AAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000muAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2703,
													"top": 140,
													"width": 330,
													"height": 59,
													"text": "BlockStatusMessage is anonymous: BlockId,\nOccupancy, Signal, Switch, Crossing, Maintenance.\nIt never carries a TrainId."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000r9AAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000muAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2703,
													"top": 578,
													"width": 330,
													"height": 59,
													"text": "Sequential-occupancy tracking: only a change INTO\nOccupied counts, route blocks are never skipped,\nclears never move a train, and CTC never guesses."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000raAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000muAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2703,
													"top": 649,
													"width": 330,
													"height": 44,
													"text": "TrainLocationTracker has advanced that train:\nCurrentBlockId = block, ActiveRouteIndex++."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000rbAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000muAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2703,
													"top": 932,
													"width": 330,
													"height": 98,
													"text": "At a stop: Phase = Dwelling (dwell > 0,\nReadyToDepartTime = arrival + dwell), Arrived\n(dwell 0) or Completed (final stop). The dwell\nends on a later System Time update (SD - Queue and\nAutomatically Dispatch Trains)."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000rcAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000muAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2703,
													"top": 1033,
													"width": 330,
													"height": 44,
													"text": "Ambiguous: no train location is changed; the\ndispatcher sees a warning."
												},
												{
													"_type": "UMLSeqMessageView",
