															"parentStyle": false,
															"left": 398,
															"top": 6986,
															"width": 563,
															"height": 61,
															"text": "train.Refresh()   // rebuilds the Stops grid\nif selected: SelectedStop = train.Stops[previous StopIndex] ?? train.Stops[0]\n             LoadEditedPlan()"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGiQCmIA15TGFkF",
															"_parent": {
																"$ref": "AAAAAAGiSQl/XPFCF6KJ"
