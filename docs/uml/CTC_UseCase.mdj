												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000ysAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000teAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2062,
													"top": 248,
													"width": 330,
													"height": 59,
													"text": "Maintenance Mode is a local CTC operator mode. It\nonly enables the Block Controls: no CTC state\nchanges and nothing is sent."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000ytAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000teAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2062,
													"top": 894,
													"width": 330,
													"height": 98,
													"text": "RequestedMaintenanceState records what CTC asked\nfor. The displayed (confirmed) state stays Open\nuntil the Track Controller reports otherwise.\nMeanwhile the block is unsafe for authority and\nClose/Reopen are disabled."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000yuAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000teAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2062,
													"top": 1340,
													"width": 330,
													"height": 59,
													"text": "A switch request records nothing in CTC; the\ndisplayed switch position changes only on\nconfirmation."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000yvAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP20000teAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2062,
													"top": 1411,
													"width": 330,
													"height": 44,
													"text": "Later, the Track Controller confirms what it\nactually did."
												},
