															"left": 398,
															"top": 7107,
															"width": 675,
															"height": 46,
															"text": "CommunicationStatus = \"{train} movement plan updated: {TargetBlockId} at {TargetArrivalTime},\n    dwell {n} s (timing recalculated).\" + (e.Message != null ? \" Warning: {e.Message}\" : \"\")"
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGiESUQbm87q0Yp",
