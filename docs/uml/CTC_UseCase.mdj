												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000cjAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 140,
													"width": 330,
													"height": 59,
													"text": "The line comes from the global Current Line\nselection (MainWindowViewModel sets\nScheduleBuilderViewModel.Line)."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000ckAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 423,
													"width": 330,
													"height": 59,
													"text": "One row per block. Each row carries\nDefaultDwellTime from DwellTimePolicy: 45 s at a\nstation block, 0 s elsewhere."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000clAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 631,
													"width": 330,
													"height": 59,
													"text": "Uploading only loads the template for review. It\ndoes NOT queue the schedule; the dispatcher still\nreviews it and presses Queue Schedule."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000cmAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 771,
													"width": 330,
													"height": 59,
													"text": "Clears only the editable template. Queued\nschedule, dispatched trains and system time in CTC\nare untouched."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000cnAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 842,
													"width": 330,
													"height": 74,
													"text": "Timing a blank cell gives it the row's default\ndwell (45 s station / 0 s otherwise); the route\nstart block never dwells. Any dwell can be\noverridden."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000coAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 1064,
													"width": 330,
													"height": 59,
													"text": "Convert validates times, routes each train through\nthe blank blocks between its timed blocks, and\nresolves blank dwell to the default."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP20000cpAAAAAAAA",
													"_parent": {
														"$ref": "CTCWP2000089AAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2020,
													"top": 1415,
													"width": 330,
													"height": 74,
													"text": "QueueSchedule never dispatches. Trains leave the\nqueue only when System Time reaches their\ndeparture time (see SD - Queue and Automatically\nDispatch Trains)."
												},
