						},
						{
							"_type": "UMLUseCaseSubject",
							"_id": "CTCWP2000007AAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "CTC Module",
							"ownedElements": [
								{
									"_type": "UMLUseCase",
									"_id": "AAAAAAGhaitLQ3AJvqw=",
									"_parent": {
										"$ref": "CTCWP2000007AAAAAAAA"
									},
									"name": "Change Simulation Speed"
								}
							]
						},
						{
							"_type": "UMLUseCase",
							"_id": "CTCWP2000008AAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "Prepare Schedule",
							"documentation": "UC1. Dispatcher generates a schedule template (or uploads a CSV schedule), enters arrival times, sets/overrides dwell times (default 45 s at a station, 0 s elsewhere), may clear the template, reviews it and queues it. Uploading never queues by itself.\nRealized by sequence diagram \"SD - Prepare Schedule\" (package CTC::Sequence Diagrams)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "CTCWP2000009AAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "Queue and Automatically Dispatch Trains",
							"documentation": "UC2. Queued trains are validated and ordered by departure time. Each System Time update releases every queued train with DepartureTime <= SystemTime: CTC checks the start block via authority, calculates suggested speed and authority, sends MovementSuggestion + MovementRequest to the Track Controller and only then moves the train from queued to dispatched. There is no manual Dispatch button.\nRealized by sequence diagram \"SD - Queue and Automatically Dispatch Trains\" (package CTC::Sequence Diagrams)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "CTCWP200000aAAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "Monitor Territory and Train Operations",
							"documentation": "UC3. Dispatcher observes block occupancy, maintenance, switch, signal and crossing state, tickets sold/hour, the dispatch queue, dispatched trains with their occupancy-inferred location, suggested speed/authority, Active Movement Plan, target, arrival time, dwell state and movement phase.\nRealized by sequence diagram \"SD - Monitor Territory and Train Operations\" (package CTC::Sequence Diagrams)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "CTCWP200000bAAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "Manage Track Maintenance and Switches",
							"documentation": "UC4. In local Maintenance Mode the dispatcher requests closing/reopening a block or moving a switch. Requests are sent to the Track Controller; the displayed state changes only when the Track Controller confirms it in a later BlockStatusMessage.\nRealized by sequence diagram \"SD - Manage Track Maintenance and Switches\" (package CTC::Sequence Diagrams)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "CTCWP200000cAAAAAAAA",
							"_parent": {
								"$ref": "CTCWP2000001AAAAAAAA"
							},
							"name": "Update Active Movement Plan",
							"documentation": "UC5. Dispatcher changes a dispatched train's stop: destination block, planned arrival time and/or dwell time. CTC re-routes (destination change), re-validates timing, recalculates the affected speed/authority and sends a new MovementSuggestion when the movement under way or the route changed; the plan is committed only after a successful send.\nRealized by sequence diagram \"SD - Update Active Movement Plan\" (package CTC::Sequence Diagrams)."
						}
					]
				},
