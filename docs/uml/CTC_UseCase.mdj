													"top": 298,
													"width": 330,
													"height": 44,
													"text": "The edit fields are loaded with the stop's current\ndestination, arrival time and dwell."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP2000164AAAAAAAA",
													"_parent": {
														"$ref": "CTCWP200010jAAAAAAAA"
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 2383,
													"top": 354,
													"width": 330,
													"height": 74,
													"text": "Choosing a different destination resets the edited\ndwell to the DwellTimePolicy default (45 s\nstation, 0 s otherwise). The dispatcher may\noverride it before applying."
												},
												{
													"_type": "UMLNoteView",
													"_id": "CTCWP2000165AAAAAAAA",
													"_parent": {
														"$ref": "CTCWP200010jAAAAAAAA"
